{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/meals",
      "destination": "/api/index?__route=/meals"
    },
    {
      "source": "/watchlist/process",
      "destination": "/api/index?__route=/watchlist/process"
    },
    {
      "source": "/watchlist/:id",
      "destination": "/api/index?__route=/watchlist/:id"
    },
    {
      "source": "/watchlist",
      "destination": "/api/index?__route=/watchlist"
    },
    {
      "source": "/history",
      "destination": "/api/index?__route=/history"
    },
    {
      "source": "/undo/:position",
      "destination": "/api/index?__route=/undo/:position"
    },
    {
      "source": "/undo",
      "destination": "/api/index?__route=/undo"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
