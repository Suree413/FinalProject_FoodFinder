{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/meals",
      "destination": "/api/legacy/meals"
    },
    {
      "source": "/watchlist/process",
      "destination": "/api/legacy/watchlist/process"
    },
    {
      "source": "/watchlist/:id",
      "destination": "/api/legacy/watchlist/:id"
    },
    {
      "source": "/watchlist",
      "destination": "/api/legacy/watchlist"
    },
    {
      "source": "/history",
      "destination": "/api/legacy/history"
    },
    {
      "source": "/undo/:position",
      "destination": "/api/legacy/undo/:position"
    },
    {
      "source": "/undo",
      "destination": "/api/legacy/undo"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
